# ═══════════════════════════════════════════════════════════════════════════
# AI Outreach Intelligence — environment template
# Copy to `backend/.env` (backend) and set the NEXT_PUBLIC_* values in `frontend/.env.local`.
# NEVER commit real values. Leave an optional integration blank to disable it.
# Generate secrets with:  python backend/scripts/gen_secrets.py
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | test | production
APP_ROLE=all                        # api | worker | all  (all = API + background workers in one service)
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000  # production: public https URL (used for CORS + links)
BACKEND_URL=http://localhost:8000   # production: public https URL (used for unsubscribe links + OAuth callbacks)

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string. Use the *direct* or *session pooler*
# string for migrations; the transaction pooler (port 6543) works for the app (prepared statements are
# disabled automatically). `postgresql://` is rewritten to the asyncpg driver for you.
DATABASE_URL=
# Optional: direct (non-pooled) URL used only by Alembic migrations.
MIGRATION_DATABASE_URL=
# Used by the test-suite only (CI sets it; locally a throw-away Postgres is started automatically).
DATABASE_URL_TEST=

# ── Redis (Upstash / Render Key-Value) — queue + rate limiting ─────────────
REDIS_URL=redis://localhost:6379/0

# ── Supabase Auth ──────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=                  # public key; safe for the frontend (NEXT_PUBLIC_SUPABASE_ANON_KEY)
SUPABASE_SERVICE_ROLE_KEY=          # SECRET — backend only, never in the frontend
SUPABASE_JWT_SECRET=                # legacy HS256 projects; asymmetric projects use the JWKS URL automatically
OWNER_EMAILS=                       # comma-separated allow-list — only these accounts may sign in (personal tool)

# ── Our own secrets ────────────────────────────────────────────────────────
ENCRYPTION_KEY=                     # Fernet key(s), comma-separated for rotation (first encrypts). Encrypts OAuth tokens/API keys at rest
JWT_SECRET=                         # >= 32 chars. Signs unsubscribe links / OAuth state

# ── AI (Groq is primary; more providers are added through the provider registry) ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gmail API (Google Cloud Console → OAuth client "Web application") ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
GOOGLE_PUBSUB_TOPIC=                # projects/<project-id>/topics/<topic>  (optional: polling fallback is used when blank)
GOOGLE_PUBSUB_AUDIENCE=             # expected audience of the Pub/Sub push OIDC token (your webhook URL)

# ── Optional discovery / verification / notification providers ────────────
HUNTER_API_KEY=
FIRECRAWL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Behaviour ──────────────────────────────────────────────────────────────
USE_MOCK_PROVIDERS=false            # true = every external capability uses deterministic mocks (dev/demo only; refused in production)
CONTROLLER_TICK_SECONDS=30
GMAIL_POLL_SECONDS=90

# ── Frontend (frontend/.env.local) ─────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
