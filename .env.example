# ═══════════════════════════════════════════════════════════════════════════
# AI Outreach Intelligence — environment template
# Copy to `backend/.env` (the API) and put the dashboard's own settings (see the end) in `frontend/.env.local`.
# NEVER commit real values. Leave an optional integration blank to disable it.
# Generate secrets with:  python backend/scripts/gen_secrets.py
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | test | production
APP_ROLE=all                        # api | worker | all  (all = API + background workers in one service)
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000  # production: public https URL (used for CORS + links)
BACKEND_URL=http://localhost:8000   # production: public https URL (used for unsubscribe links + OAuth callbacks)

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string. Use the *direct* or *session pooler*
# string for migrations; the transaction pooler (port 6543) works for the app (prepared statements are
# disabled automatically). `postgresql://` is rewritten to the asyncpg driver for you.
DATABASE_URL=
# Optional: direct (non-pooled) URL used only by Alembic migrations.
MIGRATION_DATABASE_URL=
# Used by the test-suite only (CI sets it; locally a throw-away Postgres is started automatically).
DATABASE_URL_TEST=

# (No Redis: the job queue is a PostgreSQL table and rate limiting is in-process — ADR-024.)

# ── Supabase Auth ──────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=                  # the publishable key (not secret, but only the dashboard SERVER needs it — never the browser)
SUPABASE_SERVICE_ROLE_KEY=          # SECRET — backend only, never in the frontend
SUPABASE_JWT_SECRET=                # NOT USED: sessions are verified with the project's public keys (ES256/RS256, via JWKS); HS256 is refused
OWNER_EMAILS=                       # comma-separated allow-list, e.g. a@example.com,b@example.com — only these accounts may use the app
AUTH_REQUIRE_MFA=false              # true = also demand a second factor (Supabase TOTP, AAL2); enable once MFA is enrolled

# ── Our own secrets ────────────────────────────────────────────────────────
ENCRYPTION_KEY=                     # Fernet key(s), comma-separated for rotation (first encrypts). Encrypts OAuth tokens/API keys at rest
JWT_SECRET=                         # >= 32 chars. Signs unsubscribe links / OAuth state

# ── AI (Groq is primary; more providers are added through the provider registry) ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# ── Gmail API (Google Cloud Console → OAuth client "Web application") ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/gmail/callback   # a DASHBOARD route (ADR-034); must match the Google console exactly
GOOGLE_PUBSUB_TOPIC=                # projects/<project-id>/topics/<topic>  (optional: polling fallback is used when blank)
GOOGLE_PUBSUB_AUDIENCE=             # expected audience of the Pub/Sub push OIDC token (your webhook URL)

# ── Optional discovery / verification / notification providers ────────────
HUNTER_API_KEY=
FIRECRAWL_API_KEY=
GEOAPIFY_API_KEY=
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=
MAILBOXVALIDATOR_API_KEY=
ZEROBOUNCE_API_KEY=
ABSTRACT_EMAIL_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
PDL_API_KEY=
COMPANIES_HOUSE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Behaviour ──────────────────────────────────────────────────────────────
USE_MOCK_PROVIDERS=false            # true = every external capability uses deterministic mocks (dev/demo only; refused in production)
CONTROLLER_TICK_SECONDS=30
GMAIL_POLL_SECONDS=90
BACKGROUND_ENABLED=                # empty = on (off in tests); false to run an API-only process, true to force it on

# ── Dashboard (frontend/.env.local) ────────────────────────────────────────
# Read by the Next.js SERVER only — nothing here is sent to the browser (there are no NEXT_PUBLIC_* settings).
# Every URL must be https:// (http:// only for localhost).
# SUPABASE_URL=                      # same project as the backend
# SUPABASE_ANON_KEY=                 # the publishable key
# BACKEND_URL=http://localhost:8000  # where the dashboard server reaches the API
# APP_URL=http://localhost:3000      # the dashboard's own public address (what a genuine Origin header looks like)
