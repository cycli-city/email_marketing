#!/bin/sh
# "Never push red": secret scan + fast backend/frontend gates. Enabled by: git config core.hooksPath .githooks
# Escape hatch for emergencies only: SKIP_PREPUSH_CHECKS=1 git push   (the secret scan still runs)
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

PY="$ROOT/backend/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY="$ROOT/backend/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"

"$PY" scripts/scan_secrets.py --tree || { echo "pre-push: blocked — secrets detected." >&2; exit 1; }
"$PY" scripts/prepublic_audit.py --tree --workflows || { echo "pre-push: blocked — personal data or unsafe workflow pattern (ADR-027)." >&2; exit 1; }

if [ "$SKIP_PREPUSH_CHECKS" = "1" ]; then
  echo "pre-push: quality gates skipped (SKIP_PREPUSH_CHECKS=1)"
  exit 0
fi

(
  cd backend &&
  "$PY" -m ruff check app tests scripts migrations &&
  "$PY" -m ruff format --check app tests scripts &&
  "$PY" -m mypy &&
  "$PY" -m pytest tests/unit -q -p no:cacheprovider
) || { echo "pre-push: backend gate failed." >&2; exit 1; }

(
  cd frontend &&
  npm run --silent lint &&
  npm run --silent typecheck &&
  npm run --silent format:check &&
  npm test --silent &&
  npm run --silent build
) || { echo "pre-push: frontend gate failed." >&2; exit 1; }

# What CI checks after the build: no secret and no server-only variable NAME may reach the browser bundle.
"$PY" scripts/scan_secrets.py --path frontend/.next/static --forbid-names --allow-anon-jwt   || { echo "pre-push: blocked — the browser bundle contains a secret or a server-only name." >&2; exit 1; }

echo "pre-push: all gates passed."
