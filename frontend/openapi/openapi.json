{
  "components": {
    "schemas": {
      "AccountOut": {
        "properties": {
          "account_type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "connected_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connected At"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_sync_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sync At"
          },
          "mode": {
            "$ref": "#/components/schemas/CampaignMode"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "mode",
          "status",
          "account_type",
          "scopes",
          "connected_at",
          "last_sync_at",
          "last_error"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "AccountStatus": {
        "enum": [
          "active",
          "needs_reauth",
          "disconnected",
          "error"
        ],
        "title": "AccountStatus",
        "type": "string"
      },
      "AccountType": {
        "enum": [
          "personal_gmail",
          "google_workspace",
          "transactional"
        ],
        "title": "AccountType",
        "type": "string"
      },
      "AccountsResponse": {
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/AccountOut"
            },
            "title": "Accounts",
            "type": "array"
          }
        },
        "required": [
          "accounts"
        ],
        "title": "AccountsResponse",
        "type": "object"
      },
      "CampaignMode": {
        "description": "The two operating modes. Data, templates, senders and categories never mix across modes.",
        "enum": [
          "nexora",
          "job_hunter"
        ],
        "title": "CampaignMode",
        "type": "string"
      },
      "ConnectRequest": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/CampaignMode"
          }
        },
        "required": [
          "mode"
        ],
        "title": "ConnectRequest",
        "type": "object"
      },
      "ConnectResponse": {
        "properties": {
          "authorization_url": {
            "title": "Authorization Url",
            "type": "string"
          }
        },
        "required": [
          "authorization_url"
        ],
        "title": "ConnectResponse",
        "type": "object"
      },
      "ConsentPolicy": {
        "enum": [
          "allowed",
          "requires_consent",
          "blocked"
        ],
        "title": "ConsentPolicy",
        "type": "string"
      },
      "ExchangeRequest": {
        "properties": {
          "code": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "state": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "code",
          "state"
        ],
        "title": "ExchangeRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "LiveResponse",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "assurance_level": {
            "title": "Assurance Level",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "session_expires_at": {
            "format": "date-time",
            "title": "Session Expires At",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "workspace_id",
          "assurance_level",
          "session_expires_at"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "PoliciesResponse": {
        "properties": {
          "policies": {
            "items": {
              "$ref": "#/components/schemas/PolicyOut"
            },
            "title": "Policies",
            "type": "array"
          },
          "unreviewed": {
            "title": "Unreviewed",
            "type": "integer"
          }
        },
        "required": [
          "policies",
          "unreviewed"
        ],
        "title": "PoliciesResponse",
        "type": "object"
      },
      "PolicyOut": {
        "properties": {
          "cold_b2b_marketing": {
            "$ref": "#/components/schemas/ConsentPolicy"
          },
          "cold_to_individuals": {
            "$ref": "#/components/schemas/ConsentPolicy"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "requires_postal_address": {
            "title": "Requires Postal Address",
            "type": "boolean"
          },
          "requires_sender_identification": {
            "default": true,
            "title": "Requires Sender Identification",
            "type": "boolean"
          },
          "requires_unsubscribe": {
            "title": "Requires Unsubscribe",
            "type": "boolean"
          },
          "reviewed_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed On"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "country",
          "cold_b2b_marketing",
          "cold_to_individuals",
          "requires_unsubscribe",
          "requires_postal_address",
          "notes",
          "reviewed_on",
          "version"
        ],
        "title": "PolicyOut",
        "type": "object"
      },
      "PolicyPatch": {
        "properties": {
          "acknowledge_loosening": {
            "default": false,
            "title": "Acknowledge Loosening",
            "type": "boolean"
          },
          "cold_b2b_marketing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConsentPolicy"
              },
              {
                "type": "null"
              }
            ]
          },
          "cold_to_individuals": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConsentPolicy"
              },
              {
                "type": "null"
              }
            ]
          },
          "mark_reviewed": {
            "default": true,
            "title": "Mark Reviewed",
            "type": "boolean"
          },
          "requires_postal_address": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requires Postal Address"
          },
          "requires_unsubscribe": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requires Unsubscribe"
          }
        },
        "title": "PolicyPatch",
        "type": "object"
      },
      "ProfileSlot": {
        "properties": {
          "missing": {
            "items": {
              "type": "string"
            },
            "title": "Missing",
            "type": "array"
          },
          "mode": {
            "$ref": "#/components/schemas/CampaignMode"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SenderProfileOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "mode",
          "profile",
          "missing"
        ],
        "title": "ProfileSlot",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "error"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SenderProfileIn": {
        "description": "Bounded on the way in; the service cleans and validates further.",
        "properties": {
          "display_name": {
            "maxLength": 400,
            "title": "Display Name",
            "type": "string"
          },
          "postal_address": {
            "anyOf": [
              {
                "maxLength": 1500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postal Address"
          },
          "reply_to": {
            "anyOf": [
              {
                "maxLength": 400,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply To"
          },
          "signature_text": {
            "anyOf": [
              {
                "maxLength": 6000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature Text"
          },
          "website": {
            "anyOf": [
              {
                "maxLength": 600,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "SenderProfileIn",
        "type": "object"
      },
      "SenderProfileOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "postal_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postal Address"
          },
          "reply_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply To"
          },
          "signature_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature Text"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          }
        },
        "required": [
          "display_name",
          "postal_address",
          "reply_to",
          "signature_text",
          "website",
          "updated_at"
        ],
        "title": "SenderProfileOut",
        "type": "object"
      },
      "SenderProfilesResponse": {
        "properties": {
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/ProfileSlot"
            },
            "title": "Profiles",
            "type": "array"
          }
        },
        "required": [
          "profiles"
        ],
        "title": "SenderProfilesResponse",
        "type": "object"
      },
      "TestResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "messages_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Messages Total"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "email",
          "messages_total"
        ],
        "title": "TestResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Supabase access token (attached by the BFF, never by the browser)",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "AI Outreach Intelligence API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/integrations/gmail/accounts": {
      "get": {
        "operationId": "accounts_api_v1_integrations_gmail_accounts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Google OAuth is not configured on this server"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Connected Gmail mailboxes",
        "tags": [
          "integrations"
        ]
      }
    },
    "/api/v1/integrations/gmail/accounts/{account_id}": {
      "delete": {
        "operationId": "disconnect_api_v1_integrations_gmail_accounts__account_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such mailbox"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Google OAuth is not configured on this server"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Disconnect a mailbox and revoke Google's grant",
        "tags": [
          "integrations"
        ]
      }
    },
    "/api/v1/integrations/gmail/accounts/{account_id}/test": {
      "post": {
        "operationId": "test_connection_api_v1_integrations_gmail_accounts__account_id__test_post",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such mailbox"
          },
          "409": {
            "description": "Reconnect required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Google OAuth is not configured on this server"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read-only connection check (asks Gmail for the mailbox profile; sends nothing)",
        "tags": [
          "integrations"
        ]
      }
    },
    "/api/v1/integrations/gmail/connect": {
      "post": {
        "operationId": "connect_api_v1_integrations_gmail_connect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Google OAuth is not configured on this server"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Start connecting a Gmail mailbox",
        "tags": [
          "integrations"
        ]
      }
    },
    "/api/v1/integrations/gmail/exchange": {
      "post": {
        "operationId": "exchange_api_v1_integrations_gmail_exchange_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid/expired state, or Google refused the code"
          },
          "409": {
            "description": "The mailbox is already connected for the other mode"
          },
          "422": {
            "description": "A required permission was not granted"
          },
          "503": {
            "description": "Google OAuth is not configured on this server"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Finish connecting: exchange Google's code (the state must belong to the signed-in owner)",
        "tags": [
          "integrations"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired session"
          },
          "403": {
            "description": "Not the owner, or a second factor is required"
          },
          "503": {
            "description": "Authentication is not available (fails closed)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "The authenticated owner",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/settings/policies": {
      "get": {
        "operationId": "get_policies_api_v1_settings_policies_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoliciesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Sending policy per country (the conservative defaults are created on first use)",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/v1/settings/policies/{country}": {
      "patch": {
        "operationId": "patch_policy_api_v1_settings_policies__country__patch",
        "parameters": [
          {
            "in": "path",
            "name": "country",
            "required": true,
            "schema": {
              "maxLength": 2,
              "minLength": 2,
              "pattern": "^[A-Za-z]{2}$",
              "title": "Country",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No policy for that country"
          },
          "422": {
            "description": "The change loosens the policy and was not acknowledged"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Review or change one country's policy",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/v1/settings/sender-profiles": {
      "get": {
        "operationId": "get_sender_profiles_api_v1_settings_sender_profiles_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SenderProfilesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Sender identity for each mode",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/v1/settings/sender-profiles/{mode}": {
      "put": {
        "operationId": "put_sender_profile_api_v1_settings_sender_profiles__mode__put",
        "parameters": [
          {
            "in": "path",
            "name": "mode",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CampaignMode"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SenderProfileIn"
              }
